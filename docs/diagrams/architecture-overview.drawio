                <mxCell id="leg_flow" value="&lt;b&gt;1&lt;/b&gt;&amp;nbsp; Browser request over HTTPS&lt;br&gt;&lt;b&gt;2&lt;/b&gt;&amp;nbsp; /api/* + /ws/* forwarded to the private ALB via VPC origin&lt;br&gt;&lt;b&gt;3&lt;/b&gt;&amp;nbsp; ALB forwards to the coordinator&lt;br&gt;&lt;b&gt;4&lt;/b&gt;&amp;nbsp; Coordinator relays the agent turn (HTTPS + bearer JWT); SSE streamed back&lt;br&gt;&lt;b&gt;5&lt;/b&gt;&amp;nbsp; ECS RunTask launches one Fargate worker per eval job&lt;br&gt;&lt;b&gt;6&lt;/b&gt;&amp;nbsp; Bedrock model invocation&lt;br&gt;&lt;b&gt;7&lt;/b&gt;&amp;nbsp; Live updates pushed to the browser over wss" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#414D5C;fillColor=none;strokeColor=none;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="440" y="936" width="450" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="leg_note" value="&lt;b&gt;Where agent turns run.&lt;/b&gt; In cloud, USER turns run in the AgentCore microVM — the relay replaces the in-process turn, it does not add to it. Completion and orchestrator turns still run IN-PROCESS in the coordinator, which is why both take the same per-(user, project) session claim: they write the same session and must never do it concurrently.&lt;br&gt;&lt;br&gt;&lt;b&gt;Tenant isolation.&lt;/b&gt; Per-user EFS paths (access point squashes to UID 1000) + app-layer authorization. All compute runs non-root on ARM64." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#5F6B7A;fillColor=none;strokeColor=none;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="920" y="936" width="540" height="120" as="geometry"/>
                </mxCell>
            </root>
